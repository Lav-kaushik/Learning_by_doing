{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "FastAPI Debugger",
            "type": "debugpy",
            "request": "launch",
            "module": "uvicorn",
            "cwd": "${workspaceFolder}",
            "args": [
                "main:app",
                "--port",
                "8000"
            ],
            "console": "integratedTerminal",
            "justMyCode": false
        }
    ]
}